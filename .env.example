# Supabase PostgreSQL connection string. Prefer the transaction/session pooler URL on Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Generate a long random value; Render render.yaml can generate this automatically.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
WEB_PASSWORD_HASH=replace-with-werkzeug-password-hash

# Custom GPT Action uses: Authorization: Bearer <this token>.
# Use a unique high-entropy token for this deployment; never put it in openapi.yaml.
ACTION_BEARER_TOKEN=replace-with-a-long-random-action-token

COOKIE_SECURE=true
AUTO_CREATE_SCHEMA=false
